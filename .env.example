# Each model has its own endpoint and key.
# Endpoint: paste the Azure deployment URL (deployment name and api-version are read from it),
# or leave it empty to use api.openai.com with an OpenAI key.

# GPT-4o-mini: debaters and moderator
GPT4O_MINI_ENDPOINT=https://<resource>.openai.azure.com/openai/deployments/<gpt-4o-mini-deployment>/chat/completions?api-version=2025-01-01-preview
GPT4O_MINI_API_KEY=

# GPT-4o: judge
GPT4O_ENDPOINT=https://<resource>.openai.azure.com/openai/deployments/<gpt-4o-deployment>/chat/completions?api-version=2025-01-01-preview
GPT4O_API_KEY=
